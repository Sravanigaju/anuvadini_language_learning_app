const express = require('express');
const router = express.Router();
const creatorController = require('../controllers/creatorController');

// POST: Register a new Creator
router.post('/register', creatorController.registerCreator);  //http://127.0.0.1:7273/api/creator/register

// POST: Login Creator
router.post('/login', creatorController.loginCreator);  //  http://127.0.0.1:7273/api/creator/login

// PATCH: Verify Creator (change status from unverified to verified)
router.patch('/approve/:id', creatorController.verifyCreator);

// GET: Get all creators (for admin purposes)
router.get('/all', creatorController.getAllCreators);

// GET: Get creators by status (for admin purposes)
router.get('/status/:status', creatorController.getCreatorsByStatus);

module.exports = router;